#!/bin/bash

set -euo pipefail

PATH="$PATH:node_modules/.bin"

main () {
  if [[ $# -lt 1 ]]; then
    cmd_help
  fi

  local command="cmd_$1"
  shift

  "$command" "$@"
}

cmd_help () {
  local available_commands=$(set | perl -nle'print $& while m{^cmd_\K\w+}g')
  echo -e "Available commands:\n$available_commands"
  exit 1
}

cmd_release () {
  [[ `git branch --show-current`!="master" ]] || fail 'please do not release from `master` branch'
  local changed_packages
  changed_packages=$(lerna changed --json --loglevel silent)

  local force_publish_packages
  force_publish_packages=$(printf '%s' "$changed_packages" | node ./scripts/release/get-version-force-publish.js)

  local version_args=(--exact)
  if [[ -n "$force_publish_packages" ]]; then
    version_args+=(--force-publish "$force_publish_packages")
  fi

  lerna version "${version_args[@]}"
}

cmd_version () {
  node ./scripts/release/generate-changelog.js
  node ./scripts/release/update-peer-dependency-versions.js
}

main "$@"

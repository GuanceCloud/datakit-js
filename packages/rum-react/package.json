{
    "name": "@cloudcare/browser-rum-react",
    "version": "3.3.5",
    "main": "cjs/index.js",
    "module": "esm/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "node": "./cjs/index.js",
            "import": "./esm/index.js",
            "require": "./cjs/index.js"
        },
        "./react-router-v6": {
            "types": "./types/reactRouterV6.d.ts",
            "node": "./cjs/entries/reactRouterV6.js",
            "import": "./esm/entries/reactRouterV6.js",
            "require": "./cjs/entries/reactRouterV6.js"
        },
        "./react-router-v7": {
            "types": "./types/reactRouterV7.d.ts",
            "node": "./cjs/entries/reactRouterV7.js",
            "import": "./esm/entries/reactRouterV7.js",
            "require": "./cjs/entries/reactRouterV7.js"
        },
        "./react-router-v8": {
            "types": "./types/reactRouterV8.d.ts",
            "node": "./cjs/entries/reactRouterV8.js",
            "import": "./esm/entries/reactRouterV8.js",
            "require": "./cjs/entries/reactRouterV8.js"
        },
        "./tanstack-router": {
            "types": "./types/tanstackRouter.d.ts",
            "node": "./cjs/entries/tanstackRouter.js",
            "import": "./esm/entries/tanstackRouter.js",
            "require": "./cjs/entries/tanstackRouter.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "cjs",
        "esm",
        "types",
        "react-router-v6",
        "react-router-v7",
        "react-router-v8",
        "tanstack-router",
        "README.md"
    ],
    "sideEffects": false,
    "description": "Guance Browser SDK RUM React integration",
    "scripts": {
        "build": "run-p build:cjs build:esm",
        "build:cjs": "rm -rf cjs && babel --config-file ./babel.cjs.json --out-dir cjs ./src",
        "build:esm": "rm -rf esm && babel --config-file ./babel.esm.json --out-dir esm ./src",
        "demo:build": "webpack --config demo/webpack.config.js --mode=development",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@cloudcare/browser-core": "3.3.4"
    },
    "peerDependencies": {
        "@cloudcare/browser-rum": ">=3.3.5",
        "@cloudcare/browser-rum-slim": ">=3.3.5",
        "@tanstack/react-router": ">=1.64.0 <2",
        "react-router": "6 || 7 || 8",
        "react-router-dom": "6 || 7",
        "react": "18 || 19"
    },
    "peerDependenciesMeta": {
        "@cloudcare/browser-rum": {
            "optional": true
        },
        "@cloudcare/browser-rum-slim": {
            "optional": true
        },
        "@tanstack/react-router": {
            "optional": true
        },
        "react-router": {
            "optional": true
        },
        "react-router-dom": {
            "optional": true
        }
    },
    "devDependencies": {
        "@tanstack/react-router": "1.170.17",
        "@types/react": "19.2.17",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-router": "8.1.0",
        "react-router-7": "npm:react-router@7.18.1",
        "react-router-dom": "6.30.1"
    },
    "keywords": [
        "dataflux",
        "rum",
        "react",
        "sdk"
    ],
    "repository": {
        "url": "https://github.com/GuanceCloud/datakit-js",
        "type": "git",
        "directory": "packages/rum-react"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": "dataflux",
    "license": "MIT",
    "homepage": "https://github.com/GuanceCloud/datakit-js/README.md"
}

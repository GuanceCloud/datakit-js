{
    "name": "@cloudcare/browser-rum-webgl",
    "version": "3.3.7",
    "main": "cjs/index.js",
    "module": "esm/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "node": "./cjs/index.js",
            "import": "./esm/index.js",
            "require": "./cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "cjs",
        "esm",
        "bundle",
        "types",
        "README.md"
    ],
    "sideEffects": false,
    "description": "Optional WebGL Session Replay plugin for Guance Browser RUM",
    "scripts": {
        "build": "run-p build:cjs build:esm build:bundle",
        "build:cjs": "rm -rf cjs && babel --config-file ./babel.cjs.json --out-dir cjs ./src && node ../../scripts/strip-source-map-sources-content.js cjs",
        "build:esm": "rm -rf esm && babel --config-file ./babel.esm.json --out-dir esm ./src && node ../../scripts/strip-source-map-sources-content.js esm",
        "build:bundle": "rm -rf bundle && webpack --mode=production && npm run check:bundle-contract && npm run check:bundle-size",
        "check:bundle-contract": "node ./scripts/check-bundle-contract.js",
        "check:bundle-size": "node ./scripts/check-bundle-size.js",
        "publish:oss:current": "npm run build:bundle && node ./scripts/publish-oss.js current",
        "publish:oss:lts": "npm run build:bundle && node ./scripts/publish-oss.js lts",
        "publish:oss:test": "npm run build:bundle && node ./scripts/publish-oss.js test",
        "prepack": "npm run build"
    },
    "peerDependencies": {
        "@cloudcare/browser-rum": ">=3.3.7"
    },
    "keywords": [
        "dataflux",
        "rum",
        "session-replay",
        "webgl",
        "cocos-creator",
        "sdk"
    ],
    "repository": {
        "url": "https://github.com/GuanceCloud/datakit-js",
        "type": "git",
        "directory": "packages/rum-webgl"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": "dataflux",
    "license": "MIT",
    "homepage": "https://github.com/GuanceCloud/datakit-js/README.md",
    "browserSdkPeerMinimums": {
        "@cloudcare/browser-rum": "3.3.7"
    }
}

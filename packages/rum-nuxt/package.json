{
    "name": "@cloudcare/browser-rum-nuxt",
    "version": "3.3.10",
    "main": "cjs/index.js",
    "module": "esm/index.js",
    "types": "types/index.d.ts",
    "files": [
        "cjs",
        "esm",
        "types",
        "README.md"
    ],
    "sideEffects": false,
    "description": "Guance Browser SDK RUM Nuxt integration",
    "scripts": {
        "build": "run-p build:cjs build:esm",
        "build:cjs": "rm -rf cjs && babel --config-file ./babel.cjs.json --out-dir cjs ./src",
        "build:esm": "rm -rf esm && babel --config-file ./babel.esm.json --out-dir esm ./src",
        "predemo:build": "npm run build",
        "demo:build": "nuxt build demo",
        "predemo:dev": "npm run build",
        "demo:dev": "nuxt dev demo --port 8084",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@cloudcare/browser-core": "3.3.10"
    },
    "peerDependencies": {
        "@cloudcare/browser-rum": ">=3.3.12",
        "@cloudcare/browser-rum-slim": ">=3.3.12",
        "nuxt": "3 || 4",
        "vue": "3",
        "vue-router": "4"
    },
    "peerDependenciesMeta": {
        "@cloudcare/browser-rum": {
            "optional": true
        },
        "@cloudcare/browser-rum-slim": {
            "optional": true
        }
    },
    "devDependencies": {
        "nuxt": "4.5.0",
        "vue": "3.5.22",
        "vue-router": "4.5.1"
    },
    "keywords": [
        "dataflux",
        "rum",
        "nuxt",
        "sdk"
    ],
    "repository": {
        "url": "https://github.com/GuanceCloud/datakit-js",
        "type": "git",
        "directory": "packages/rum-nuxt"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": "dataflux",
    "license": "MIT",
    "homepage": "https://github.com/GuanceCloud/datakit-js/README.md"
}

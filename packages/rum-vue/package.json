{
    "name": "@cloudcare/browser-rum-vue",
    "version": "3.3.9",
    "main": "cjs/index.js",
    "module": "esm/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "node": "./cjs/index.js",
            "import": "./esm/index.js",
            "require": "./cjs/index.js"
        },
        "./vue-router-v3": {
            "types": "./types/vueRouterV3.d.ts",
            "node": "./cjs/entries/vueRouterV3.js",
            "import": "./esm/entries/vueRouterV3.js",
            "require": "./cjs/entries/vueRouterV3.js"
        },
        "./vue-router-v4": {
            "types": "./types/vueRouterV4.d.ts",
            "node": "./cjs/entries/vueRouterV4.js",
            "import": "./esm/entries/vueRouterV4.js",
            "require": "./cjs/entries/vueRouterV4.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "cjs",
        "esm",
        "types",
        "vue-router-v3",
        "vue-router-v4",
        "README.md"
    ],
    "sideEffects": false,
    "description": "Guance Browser SDK RUM Vue integration",
    "scripts": {
        "build": "run-p build:cjs build:esm",
        "build:cjs": "rm -rf cjs && babel --config-file ./babel.cjs.json --out-dir cjs ./src",
        "build:esm": "rm -rf esm && babel --config-file ./babel.esm.json --out-dir esm ./src",
        "demo:build": "webpack --config demo/webpack.config.js --mode=development",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@cloudcare/browser-core": "3.3.9"
    },
    "peerDependencies": {
        "@cloudcare/browser-rum": ">=3.3.9",
        "@cloudcare/browser-rum-slim": ">=3.3.9",
        "vue": "2.7 || 3",
        "vue-router": "3 || 4"
    },
    "peerDependenciesMeta": {
        "@cloudcare/browser-rum": {
            "optional": true
        },
        "@cloudcare/browser-rum-slim": {
            "optional": true
        },
        "vue-router": {
            "optional": true
        }
    },
    "devDependencies": {
        "vue": "3.5.22",
        "vue-router": "4.5.1"
    },
    "keywords": [
        "dataflux",
        "rum",
        "vue",
        "sdk"
    ],
    "repository": {
        "url": "https://github.com/GuanceCloud/datakit-js",
        "type": "git",
        "directory": "packages/rum-vue"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": "dataflux",
    "license": "MIT",
    "homepage": "https://github.com/GuanceCloud/datakit-js/README.md"
}

{
    "name": "@cloudcare/browser-worker",
    "version": "3.3.10",
    "main": "bundle/worker.js",
    "scripts": {
        "build": "node ../../scripts/build-worker-bundles.js",
        "build:unlocked": "rm -rf bundle && webpack --mode=production && npm run check:bundle-contract && npm run check:package-content",
        "check:bundle-contract": "node ../../scripts/check-worker-bundle-contract.js bundle/worker.js bundle/canvas-worker.js",
        "check:package-content": "node ../../scripts/check-worker-package-content.js",
        "publish:oss:current": "npm run build && node ./scripts/publish-oss.js current",
        "publish:oss:lts": "npm run build && node ./scripts/publish-oss.js lts",
        "publish:oss:test": "npm run build && node ./scripts/publish-oss.js test"
    },
    "dependencies": {
        "@cloudcare/browser-core": "3.3.10"
    },
    "keywords": [
        "dataflux",
        "worker",
        "sdk"
    ],
    "repository": {
        "url": "https://github.com/GuanceCloud/datakit-js",
        "type": "git",
        "directory": "packages/worker"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "webpack": "5.91.0"
    },
    "author": "dataflux",
    "license": "MIT",
    "gitHead": "47f9fa1890683efb7cf6995e4d038eb5dec7113a"
}

{
    "name": "browser-sdk",
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@babel/cli": "^7.22.10",
        "@babel/core": "^7.22.9",
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@babel/preset-env": "^7.22.9",
        "@jsdevtools/coverage-istanbul-loader": "3.0.5",
        "ali-cdn-sdk": "^1.2.0",
        "ali-oss": "^6.12.0",
        "babel-loader": "^9.1.3",
        "co": "^4.6.0",
        "emoji-name-map": "1.2.9",
        "glob": "10.3.3",
        "jasmine-core": "3.99.1",
        "karma": "6.4.2",
        "karma-browserstack-launcher": "1.6.0",
        "karma-chrome-launcher": "3.2.0",
        "karma-coverage-istanbul-reporter": "3.0.3",
        "karma-jasmine": "4.0.2",
        "karma-junit-reporter": "2.0.1",
        "karma-sourcemap-loader": "0.4.0",
        "karma-spec-reporter": "0.0.36",
        "karma-webpack": "5.0.0",
        "lerna": "^8.1.2",
        "npm-run-all": "^4.1.5",
        "typescript": "5.8.3",
        "webpack": "5.91.0",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "^4.15.1",
        "ws": "8.21.1"
    },
    "overrides": {
        "@babel/traverse": "7.26.9"
    },
    "scripts": {
        "build": "lerna run build --stream",
        "build:bundle": "lerna run build:bundle --stream",
        "check:bundle-size": "npm run build:bundle --workspace @cloudcare/browser-rum",
        "check:bundle-size:artifact": "node scripts/check-bundle-size.js",
        "publish:npm": "npm run build && lerna publish from-package",
        "publish:oss:current": "lerna run publish:oss:current --stream",
        "publish:oss:lts": "lerna run publish:oss:lts --stream",
        "publish:oss:test": "lerna run publish:oss:test --stream",
        "dev": "node scripts/dev-server.js",
        "demo:runtime:build": "npm run build:esm --workspace @cloudcare/browser-rum --workspace @cloudcare/browser-rum-react",
        "demo:static:build": "run-p demo:react:build demo:vue:build demo:angular:build",
        "demo:react:build": "npm run demo:build --workspace @cloudcare/browser-rum-react",
        "demo:vue:build": "npm run demo:build --workspace @cloudcare/browser-rum-vue",
        "demo:angular:build": "npm run demo:build --workspace @cloudcare/browser-rum-angular",
        "demo:nextjs:build:raw": "npm run demo:build --workspace @cloudcare/browser-rum-nextjs",
        "demo:nextjs:build": "run-s demo:runtime:build demo:nextjs:build:raw",
        "demo:nextjs:dev:raw": "npm run demo:dev --workspace @cloudcare/browser-rum-nextjs",
        "demo:nextjs:dev": "run-s demo:runtime:build demo:nextjs:dev:raw",
        "demo:nuxt:build:raw": "npm run demo:build --workspace @cloudcare/browser-rum-nuxt",
        "demo:nuxt:build": "run-s demo:runtime:build demo:nuxt:build:raw",
        "demo:nuxt:dev:raw": "npm run demo:dev --workspace @cloudcare/browser-rum-nuxt",
        "demo:nuxt:dev": "run-s demo:runtime:build demo:nuxt:dev:raw",
        "demo:frameworks:build": "run-s demo:runtime:build demo:static:build demo:nextjs:build:raw demo:nuxt:build:raw",
        "demo:frameworks:serve": "run-p dev demo:nextjs:dev:raw demo:nuxt:dev:raw",
        "demo:frameworks:dev": "run-s demo:runtime:build demo:frameworks:serve",
        "release": "scripts/cli release",
        "version": "scripts/cli version",
        "test": "npm run test:unit:watch",
        "test:unit": "node ./scripts/test-unit.js",
        "test:unit:file": "node ./scripts/test-unit.js --spec",
        "test:unit:grep": "node ./scripts/test-unit.js --grep",
        "test:exports:frameworks": "node ./scripts/test-framework-package-exports.js",
        "test:types:frameworks": "tsc --project test/types/framework-plugins.tsconfig.json",
        "test:unit:watch": "npm run test:unit --no-single-run"
    },
    "keywords": [
        "dataflux",
        "rum",
        "sdk"
    ],
    "repository": {
        "url": "https://github.com/DataFlux-cn/datakit-js",
        "type": "git"
    },
    "author": {
        "name": "dataflux",
        "email": "dcl@jiagouyun.com"
    },
    "license": "MIT",
    "dependencies": {
        "@babel/runtime": "^7.26.0"
    }
}
